# Raw data and credentials
data/*
!data/.gitkeep
*.zip
kaggle.json

# CSV files are data by default. The small, reviewable experiment summaries
# below are intentionally versioned.
*.csv
!experiments/edgeiiot_federated/results/*.csv
!experiments/edgeiiot_federated/results_clean/*.csv
!experiments/edgeiiot_federated/artifacts/*.csv
!experiments/edgeiiot_federated/artifacts_clean/*.csv
!experiments/uavids_federated/phase4/results/*.csv
!experiments/uavids_federated/phase5/results/*.csv

# Python / Jupyter
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
.venv-gui/
*.egg-info/

# Generated models and preprocessing objects
*.pt
*.pth
*.pkl
*.joblib
*.h5
*.model

# Small, frozen deployment artifacts required by the UAVIDS GUI adapter and
# Docker demo. The adapter hash-checks both before loading them. Other model
# checkpoints and preprocessing objects remain excluded by the rules above.
!experiments/uavids_federated/artifacts_phase3/federated_global_model.pt
!experiments/uavids_federated/artifacts_phase3/training_only_preprocessor.joblib

# Generated experiment data/cache
artifacts/test_raw.csv
artifacts/federated_cache/
experiments/uavids_federated/phase4/runtime/
experiments/uavids_federated/phase5/runtime/

# OS/editor
.DS_Store
.vscode/
.idea/

# Large generated figures
results/*.png
